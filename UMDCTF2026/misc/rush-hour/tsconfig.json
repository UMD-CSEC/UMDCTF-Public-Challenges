{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": true,
    "sourceMap": true,
    "lib": ["ES2017", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}
